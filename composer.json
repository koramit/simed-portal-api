{
    "name": "koramit/simed-portal-api",
    "description": "Laravel package for SiMED Portal API",
    "type": "library",
    "require": {
        "php": "^8.3.0",
        "laravel/framework": "^12.71|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "pestphp/pest": "^4.4|^5.3",
        "orchestra/testbench": "^10.0|^11.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Koramit\\SiMEDPortalAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koramit\\SiMEDPortalAPI\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "koramit",
            "email": "koramit.p@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Koramit\\SiMEDPortalAPI\\PortalAPIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
